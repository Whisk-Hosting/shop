{
  "name": "whisk-shop",
  "version": "1.0.0",
  "private": true,
  "description": "A shop on Whisk: its pages (a Go server), site editor and admin screens, on Whisk's commerce engine.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/shop.mjs build",
    "start": "node scripts/shop.mjs start",
    "dev": "node scripts/shop.mjs dev",
    "migrate": "node scripts/shop.mjs migrate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "go test ./... && tsx --test cms/test/*.test.ts"
