  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@medusajs/admin-bundler": "2.22.2",
    "@medusajs/admin-sdk": "2.22.2",
    "@medusajs/icons": "2.22.2",
    "@medusajs/types": "2.22.2",
    "@medusajs/ui": "4.2.9",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "lodash": "4.18.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.6.6",
    "@graphql-tools/utils": "^12.1.0",
