---
// A page's blocks from the CMS (cms/src/blocks/), each drawn by the component of its name. A
// moved website adds its own blocks the same way: a component here, listed below.
import type { Block } from "../lib/cms"
import Hero from "./Hero.astro"
import Content from "./Content.astro"
import Media from "./Media.astro"
import Columns from "./Columns.astro"
import Products from "./Products.astro"
import List from "./List.astro"
import Form from "./Form.astro"
import Html from "./Html.astro"

const DRAW: Record<string, any> = { hero: Hero, content: Content, media: Media, columns: Columns, list: List, products: Products, form: Form, html: Html }

type Props = { blocks?: Block[] | null }
const blocks = (Astro.props.blocks ?? []).filter((b) => DRAW[b.blockType])
---
{blocks.map((b, i) => {
  const Draw = DRAW[b.blockType]
  return <Draw block={b} first={i === 0} />
})}
